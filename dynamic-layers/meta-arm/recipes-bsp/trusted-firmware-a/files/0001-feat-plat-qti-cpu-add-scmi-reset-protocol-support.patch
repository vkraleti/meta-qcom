 				${GIC_SOURCES}					\
 				${TIMER_SOURCES}				\
 				${CPU_SOURCES}					\
+				${BL31_CPU_SETUP_SRC}				\
+				${SCMI_SOURCES}
 
 BL31_SOURCES		+=	${QGIC_DRV_PATH}/qgic_intr_el3.c
 BL31_SOURCES		+=	$(QTI_PLAT_PATH)/${CHIPSET}/src/plat_cpuss_config.c
 
